{
  "name": "no-spend-tracker",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply no-spend-tracker --local",
    "db:migrate:remote": "wrangler d1 migrations apply no-spend-tracker --remote"
  },
  "dependencies": {
    "@hono/oauth-providers": "^0.9.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.8"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1",
    "wrangler": "^4.110.0"
  }
}
