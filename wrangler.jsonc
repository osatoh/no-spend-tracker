{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "no-spend-tracker",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-15",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "no-spend-tracker",
      // 本番用 DB は `npx wrangler d1 create no-spend-tracker` で作成し、出力された id を入れる
      "database_id": "",
      "migrations_dir": "drizzle"
    }
  ],
  "observability": {
    "enabled": true
  }
}
