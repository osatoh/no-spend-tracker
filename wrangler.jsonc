{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "no-spend-tracker",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-15",
  // D1(APAC)から遠い地域のリクエストでも DB への往復を減らせるよう、Worker の実行場所を自動で最適化する
  "placement": { "mode": "smart" },
  "assets": {
    // 未知のパスは index.html を返し、React 側でルーティングする
    "not_found_handling": "single-page-application",
    // API と認証は静的アセットより先に Worker で処理する
    "run_worker_first": ["/api/*", "/auth/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "no-spend-tracker",
      "database_id": "64c98f81-f221-4a77-af4a-a470daf1286b",
      "migrations_dir": "drizzle"
    }
  ],
  "observability": {
    "enabled": true
  }
}
